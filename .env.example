API_BIND=127.0.0.1
API_PORT=8080

POSTGRES_DB=cactus_fight
POSTGRES_USER=cactus
POSTGRES_PASSWORD=cactus_local

SPRING_PROFILES_ACTIVE=development
# Em produção, defina JWT_SECRET, MFA_ENCRYPTION_KEY e os demais segredos com valores exclusivos.
# Configure SMTP antes de iniciar o onboarding. Para um capturador local, use o IP acessível ao container.
SMTP_HOST=
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
ONBOARDING_FROM=
